{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@student-portal/shared-types": ["packages/shared-types/src"],
      "@student-portal/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}