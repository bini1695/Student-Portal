# Where your NestJS API runs (used by the Next.js proxy rewrite)
API_URL=http://localhost:4000
# Browser calls go to /api/* (proxied). Change only if you skip the proxy.
NEXT_PUBLIC_API_BASE=/api
# Set to "true" to run the UI with built-in demo data (no backend needed)
NEXT_PUBLIC_USE_MOCKS=false
# Optional: if your access token is HS256, set the same secret so middleware verifies it.
JWT_SECRET=
